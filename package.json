{
  "name": "bashlink",
  "version": "2.0.1",
  "description": "Testable, predictable and scoped code in bash.",
  "keywords": [
    "bash",
    "framework",
    "scoped",
    "shell",
    "test",
    "testing",
    "tool",
    "modules",
    "utility"
  ],
  "homepage": "https://tsickert.com/bashlink",
  "bugs": {
    "email": "info@tsickert.com",
    "url": "https://github.com/thaibault/bashlink/issues"
  },
  "license": "CC-BY-4.0",
  "author": {
    "email": "info@tsickert.com",
    "name": "Torben Sickert",
    "url": "https://tsickert.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaibault/bashlink.git"
  },
  "main": "module.sh",
  "bin": {
    "bashlink-doctest": "doctest.sh",
    "bashlink-document": "documentation.sh"
  },
  "files": [
    "arguments.sh",
    "array.sh",
    "changeroot.sh",
    "cli.sh",
    "dependency.sh",
    "dictionary.sh",
    "display.sh",
    "doctest.sh",
    "documentation.sh",
    "exception.sh",
    "filesystem.sh",
    "globals.sh",
    "logging.sh",
    "module.sh",
    "number.sh",
    "pacman.sh",
    "path.sh",
    "prompt",
    "string.sh",
    "time.sh",
    "tools.sh",
    "ui.sh"
  ],
  "scripts": {
    "clear": "[ ! -e apiDocumentation ] || rm --recursive apiDocumentation",
    "document": "mkdir --parents apiDocumentation/bashlink/latest && yarn document:show 1>apiDocumentation/bashlink/latest/index.html",
    "document:show": "./documentation.sh",
    "document:show:error": "./documentation.sh 1>/dev/null",
    "lint": "shellcheck -x *.sh prompt/*.sh && yarn lint:declarations",
    "lint:declarations": "awk '/^(declare|local|typeset)( |$)/ && !/^declare -[a-zA-Z]*g/ {print FILENAME \":\" FNR \": Top level declaration without \\\"-g\\\" is local to the importing function: \" $0; found = 1} END {exit found}' *.sh prompt/*.sh",
    "lint:given": "shellcheck -x",
    "report:coverage": "true",
    "test": "./doctest.sh --verbose",
    "update:documentation": "web-documentation"
  },
  "devDependencies": {
    "shellcheck": "^4.1.0",
    "web-documentation": "^2.0.0"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "languages": [
      "enUS",
      "deDE",
      "frFR"
    ],
    "tagline": "a high reliable bash library<!--deDE:eine bash bibliothek für hochzuverlässigkeits Ansprüche-->"
  },
  "resolutions": {
    "decompress": "npm:@xhmikosr/decompress@^11.1.4"
  },
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba"
}
